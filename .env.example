# FreqAI Pro - Environment Variables
# Copy this file to .env and fill in your values

# Admin password for app access (optional)
ADMIN_PASSWORD=

# Fonnte WhatsApp API token (https://fonnte.com)
FONNTE_TOKEN=

# WhatsApp destination number (format: 628xxxxxxxxxx)
WHATSAPP_PHONE=

# Binance API credentials (only needed for Real mode)
BINANCE_KEY=
BINANCE_SECRET=

# AI provider keys (optional, for future enhancements)
GROQ=
OPENAI=
